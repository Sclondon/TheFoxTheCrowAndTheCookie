; Engine configuration file.
config_version=5

[application]

config/name="The Fox, The Crow, and The Cookie"
config/description="An interactive music video: pan the wood, tap things, watch the fable play out."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[display]

window/size/viewport_width=844
window/size/viewport_height=390
window/stretch/mode="disabled"
window/dpi/allow_hidpi=true
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.05, 0.12, 1)
